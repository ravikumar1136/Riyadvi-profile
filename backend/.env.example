# Set these values for the Django API. Create the MySQL database first:
# CREATE DATABASE riyadvi CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
MYSQL_DATABASE=riyadvi
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
CORS_ALLOWED_ORIGINS=http://localhost:3000
